% ^^A %% Subsection 1.6.2. Lengths.
%\subsubsection{Lengths}
%
% ^^A %%% Paragraph 1.6.2.1. Length definition (declaration and initialization).
%\paragraph{Length definition (declaration and initialization)}
% ^^A %%% TODO: ADD TO REFERENCE LIST.
% ^^A %%% Source:
% ^^A %%% https://tex.stackexchange.com/a/172267
%    \begin{macrocode}
\ExplSyntaxOn
\NewDocumentCommand{\definelength}{s m m}
{
  \IfBooleanTF { #1 }
  { \frwy_util_prog_define_length:nnn { dim }  { #2 } { #3 } }
  { \frwy_util_prog_define_length:nnn { skip } { #2 } { #3 } }
}

\cs_new_protected:Npn \frwy_util_prog_define_length:nnn #1 #2 #3
{
  \cs_if_exist:cTF { #2 }
  {
    \msg_error:nnn { frwyslnd-util } { already~defined } { #2 }
  }
  {
    \__frwy_util_prog_define_length:nnn { #1 } { #2 } { #3 }
  }
}
\cs_new_protected:Npn \__frwy_util_prog_define_length:nnn #1 #2 #3
{
  \use:c { #1_new:c } { l_frwy_util_prog_#2_#1 }
  \use:c { #1_set:cn } { l_frwy_util_prog_#2_#1 } { #3 }
  \cs_set_eq:cc { #2 } { l_frwy_util_prog_#2_#1 } % user level name
}

\msg_new:nnnn { frwyslnd-util } { already~defined }
{
  Control~sequence~\exp_not:c { #1 } already~defined.
}
{
  The~control~sequence~\exp_not:c { #1 } already~exists.~
  Please~use~a~new~name;~the~command~will~not~be~executed.
}
\ExplSyntaxOff
%    \end{macrocode}
